# Copy this file to .env and fill in real values. .env is gitignored.

# MongoDB Atlas connection string (M0 free tier is fine).
# Get this from Atlas -> Database -> Connect -> Drivers.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name is fixed by project convention — leave as-is.
MONGODB_DB=finanalyzer

# REQUIRED by SEC: "Your Name your.email@example.com". Requests without a
# real User-Agent get a 403. See https://www.sec.gov/os/webmaster-faq#developers
SEC_USER_AGENT=Your Name your.email@example.com

# Chunking targets, in tokens (defaults match the Phase 1 spec — override
# only if you're experimenting).
CHUNK_SIZE_TOKENS=1000
CHUNK_OVERLAP_TOKENS=150

# Gemini API key (Phase 2 — embeddings only, no chat/generation calls).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Leave as-is — must match what's declared in the Atlas Vector Search index.
EMBEDDING_DIMENSIONS=768
VECTOR_INDEX_NAME=chunks_vector_index
