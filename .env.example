# Copy this file to .env and fill in real values. .env is gitignored.

# MongoDB Atlas connection string (M0 free tier is fine).
# Get this from Atlas -> Database -> Connect -> Drivers.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name is fixed by project convention — leave as-is.
MONGODB_DB=finanalyzer

# REQUIRED by SEC: "Your Name your.email@example.com". Requests without a
# real User-Agent get a 403. See https://www.sec.gov/os/webmaster-faq#developers
SEC_USER_AGENT=Your Name your.email@example.com

# Chunking targets, in tokens (defaults match the Phase 1 spec — override
# only if you're experimenting).
CHUNK_SIZE_TOKENS=1000
CHUNK_OVERLAP_TOKENS=150

# Gemini API key (Phase 2 — embeddings only, no chat/generation calls).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Leave as-is — must match what's declared in the Atlas Vector Search index.
EMBEDDING_DIMENSIONS=768
VECTOR_INDEX_NAME=chunks_vector_index

# Groq API key (Phase 3 — text generation: ask()'s answers and the
# groundedness judge). Get one at https://console.groq.com
GROQ_API_KEY=your-groq-api-key

# Provider + model are both config, not hardcoded — see src/fin_analyzer/providers/.
# Answer generation and the judge are deliberately different models.
# Verify these are still available to your key with:
#   uv run python -c "from fin_analyzer.config import get_settings; from fin_analyzer.providers.registry import get_provider; print(sorted(get_provider('groq', get_settings()).list_model_names()))"
GENERATION_PROVIDER=groq
GENERATION_MODEL=openai/gpt-oss-120b
JUDGE_PROVIDER=groq
JUDGE_MODEL=openai/gpt-oss-20b
